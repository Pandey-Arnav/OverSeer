# Copy this file to .env and fill in your own key.
# The backend runs without it — the AI risk engine just reports
# "unavailable" and the rule engine still produces a verdict on its own.

OPENAI_API_KEY=

# Verify this against the models available on your OpenAI account —
# model naming changes over time and this skill/session can't confirm
# it live. "gpt-4o" is a safe fallback if "gpt-5.5" isn't available to you.
OPENAI_MODEL=gpt-5.5

# Path to the SQLite database file (relative to backend/)
SENTINEL_DB_PATH=sentinel.db

# Seconds of inactivity on a tab before the debounced AI call fires.
SENTINEL_AI_DEBOUNCE_SECONDS=0.8
