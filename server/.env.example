# Copy to .env. The server runs fine with none of this set — it falls
# back to a deterministic mock explanation with no API key required.

PORT=4000

# Optional. If unset, /api/explain always returns the mock explanation.
OPENAI_API_KEY=

# Verify against your account's available models — naming changes over
# time and this repo can't confirm it for you.
OPENAI_MODEL=gpt-4o-mini

# Any OpenAI-*compatible* chat-completions endpoint works here, not just
# OpenAI itself. Examples that have been verified against this codebase:
#   OpenAI:  https://api.openai.com/v1              (default, model e.g. gpt-4o-mini)
#   Groq:    https://api.groq.com/openai/v1          (model e.g. llama-3.1-8b-instant)
#   x.AI:    https://api.x.ai/v1                      (model e.g. grok-beta — requires an
#                                                       x.AI team with credits/license)
OPENAI_BASE_URL=https://api.openai.com/v1
