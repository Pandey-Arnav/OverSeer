{
  "manifest_version": 3,
  "name": "Sentinel — Runtime Threat Guardian",
  "version": "0.1.0",
  "description": "Detects suspicious webpage behavior in real time, scores the risk locally, and blocks or warns before harm happens.",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "Sentinel — click for today's protection summary"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/page-monitor.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "shared/constants.js",
        "shared/utils.js",
        "content/content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "permissions": ["storage", "webNavigation", "tabs", "declarativeNetRequest"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
