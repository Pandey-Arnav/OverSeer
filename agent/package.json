{
  "name": "sentinel-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sentinel — local background agent that watches network connections and USB devices for intrusion signals.",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "build:dashboard": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/risk/engine.test.ts src/aegis/client.test.ts src/insights/security-insights.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4"
  }
}
