# Copy to .env. The agent runs fine with none of this set — it falls
# back to a deterministic mock explanation with no API key required.

# Dashboard/API port
SENTINEL_PORT=4100

# Keep the command center local to this machine.
SENTINEL_HOST=127.0.0.1

# Local Jac service used for AEGIS ForkGuard counterfactual review.
AEGIS_URL=http://127.0.0.1:8012

# Optional explicit path when jac is not on PATH.
# JAC_EXECUTABLE=C:\Users\you\AppData\Local\GhostShield\venv\Scripts\jac.exe

# Optional. If unset, AI explanations always use the deterministic mock.
OPENAI_API_KEY=

# Verify against your account's available models — naming changes over
# time and this repo can't confirm it for you.
OPENAI_MODEL=gpt-4o-mini

# Any OpenAI-*compatible* chat-completions endpoint works here.
#   OpenAI: https://api.openai.com/v1        (model e.g. gpt-4o-mini)
#   Groq:   https://api.groq.com/openai/v1   (model e.g. llama-3.1-8b-instant)
OPENAI_BASE_URL=https://api.openai.com/v1

# Where incident/settings JSON files live. Defaults to ~/.sentinel if unset.
# SENTINEL_DATA_DIR=/Users/you/.sentinel

# The BadUSB honeypot's command-intent classifier reuses the same
# OPENAI_API_KEY/OPENAI_MODEL/OPENAI_BASE_URL above — no separate key
# needed. Falls back to a deterministic pattern-match mock if unset —
# the timing check and the hard-coded catastrophic-command backstop
# still run either way.
