# Copy to .env. The agent runs fine with none of this set — it falls
# back to a deterministic mock explanation with no API key required.

# Dashboard/API port
SENTINEL_PORT=4100

# Optional. If unset, AI explanations always use the deterministic mock.
OPENAI_API_KEY=

# Verify against your account's available models — naming changes over
# time and this repo can't confirm it for you.
OPENAI_MODEL=gpt-4o-mini

# Any OpenAI-*compatible* chat-completions endpoint works here.
#   OpenAI: https://api.openai.com/v1        (model e.g. gpt-4o-mini)
#   Groq:   https://api.groq.com/openai/v1   (model e.g. llama-3.1-8b-instant)
OPENAI_BASE_URL=https://api.openai.com/v1

# Where incident/settings JSON files live. Defaults to ~/.sentinel if unset.
# SENTINEL_DATA_DIR=/Users/you/.sentinel
